# --- LLM gateway credentials ---------------------------------------------
# Your API key. Any one of the three is accepted (checked in this order):
#   REQUESTY_API_KEY -> OPENAI_API_KEY -> ANTHROPIC_API_KEY
# A key beginning with "rqsty-" is sent as a Requesty auth token automatically.
REQUESTY_API_KEY=

# --- Gateway base URL -----------------------------------------------------
# The Claude Agent SDK speaks the ANTHROPIC MESSAGES API, so this endpoint must
# be Anthropic-compatible. An OpenAI-only endpoint will not work.
# Any of these vars are read (in this order):
#   OPENAI_API_BASE -> BASE_URL -> ANTHROPIC_BASE_URL
# A trailing "/v1" is stripped automatically; the SDK appends its own paths.
ANTHROPIC_BASE_URL=https://router.requesty.ai
# OPENAI_API_BASE=

# --- Model ----------------------------------------------------------------
# Model id to use. This value is gateway-specific and fully replaceable —
# set it to whatever model your gateway exposes. Override per-run with --model.
ANTHROPIC_MODEL=openai/gpt-5

# --- Optional: per-phase turn budgets -------------------------------------
# Exceeding a budget aborts the run rather than silently truncating the
# analysis, so raise these if a phase reports it ran out of turns.
# RECON_MAX_TURNS=50
# ANALYST_MAX_TURNS=150
# REPORTER_MAX_TURNS=50

# --- Optional: pin the MCP servers ----------------------------------------
# ast-grep and xray are fetched and executed on this host by `uvx`, straight
# from GitHub. Unset, that means running whatever is on the default branch at
# the moment of the run. Set these to a tag or commit SHA to freeze them — the
# same argument as committing a lockfile, applied to the tool servers.
# AST_GREP_MCP_REF=
# XRAY_MCP_REF=

# --- Optional: Phase 0 Semgrep pre-scan -----------------------------------
# A deterministic Semgrep scan runs before any LLM phase, and its candidate
# findings ground the analyst's prove-or-refute work. Requires a `semgrep`
# binary on PATH, or Docker (falls back to SEMGREP_IMAGE). If neither exists
# the run aborts at startup unless you opt out.
# SEMGREP_CONFIG=auto            # ruleset; "auto" downloads from the registry
# SEMGREP_TIMEOUT=600            # wall-clock seconds for the whole scan
# SEMGREP_IMAGE=semgrep/semgrep:latest   # pin to a tag/digest to freeze it
# SAST_NO_SEMGREP=1              # opt out of Phase 0 entirely (loud warning)
